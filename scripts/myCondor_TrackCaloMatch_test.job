# Submit from the repository root:
#   condor_submit scripts/myCondor_TrackCaloMatch_test.job
#
# This test queues 10 jobs from file_run79516_00_test.list (1000 events each).
# The submit host and execute nodes must share the repository and output paths.
universe              = vanilla
notification          = Never
getenv                = False
should_transfer_files = NO

# Resolve all paths relative to the submit directory (repository root).
RepoDir               = $ENV(PWD)
initialdir            = $(RepoDir)
executable            = $(RepoDir)/scripts/runTrackCaloMatch.sh
request_memory        = 6GB
request_cpus          = 1
job_lease_duration    = 3600

OutDir                = $(RepoDir)/root/trackcalomatch_test
output                = $(RepoDir)/log/trackcalomatch_test-$(Cluster)-$(Process).out
error                 = $(RepoDir)/log/trackcalomatch_test-$(Cluster)-$(Process).err
log                   = $(RepoDir)/log/trackcalomatch_test-$(Cluster)-$(Process).log

# 5th argument enables jet reconstruction and JetChargeTreeMaker.
arguments             = $(events) $(file) $(OutDir) $(skip) true

# The input is a DST basename; the wrapper uses getinputfiles.pl to resolve it.
queue events,file,skip from fileLists/file_run79516_00_test.list
