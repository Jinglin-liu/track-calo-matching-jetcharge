# Submit from the repository root:
#   bash scripts/submitCondorTrackCaloMatch.sh --run 79516       # preview
#   bash scripts/submitCondorTrackCaloMatch.sh --run 79516 --submit
#
#   condor_q -nobatch
#
# The submit host and execute nodes must share the repository and output paths.
universe              = vanilla
notification          = Never
PeriodicHold          = (NumJobStarts>=1 && JobStatus == 1)
getenv                = False
should_transfer_files = NO

# Production template: submission driver generates a temporary .job per group,
# appends _run<run> to the base OutDir, and overrides the queue-from line.
# Never point at *_test lists.
# Resolve all paths relative to the submit directory (repository root).
RepoDir               = /sphenix/user/jlnliu/projects/track-calo-matching/track-calo-matching-jetcharge
initialdir            = $(RepoDir)
executable            = $(RepoDir)/scripts/runTrackCaloMatch.sh
request_memory        = 6GB
job_lease_duration    = 3600

OutDir                = $(RepoDir)/root/trackcalomatch_5GeV_unsub
output                = $(RepoDir)/log/trackcalomatch_prod-$(Cluster)-$(Process).out
error                 = $(RepoDir)/log/trackcalomatch_prod-$(Cluster)-$(Process).err
log                   = /tmp/jlnliu/trackcalomatch_prod-$(Cluster)-$(Process).log

# Set to "unsubtracted" (default reconstruction) or "sub1" (sPHENIX Sub1 towers).
# This is the 6th argument to runTrackCaloMatch.sh; 5th enables jet-charge output;
# 7th argument switches TrackToCalo module; 8th is the tower pT cut.
# Jet pT >= 5 GeV/c and track pT >= 0.5 GeV/c are configured in the ROOT macro.
JetMode               = unsubtracted
minTowerPt            = 0.0
arguments             = $(events) $(file) $(OutDir) $(skip) true $(JetMode) false $(minTowerPt)

# The input is a DST basename; the wrapper uses getinputfiles.pl to resolve it.
queue events,file,skip from $(RepoDir)/fileLists/file_run79516_00.list
